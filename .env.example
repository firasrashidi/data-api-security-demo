# Copy to .env and fill in real values. Never commit .env.
# Generate the two private secrets separately. They must not match.
#   openssl rand -base64 32

# Supabase project
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_INTERNAL_API_KEY=
# Used only by psql. The SQL editor avoids putting the database password in shell history.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Worker to private backend. Different value from SUPABASE_INTERNAL_API_KEY.
BACKEND_AUTH_TOKEN=

# Cloudflare Access
CF_ACCESS_TEAM_DOMAIN=https://<team-name>.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
WORKER_URL=https://supabase-secure-api-demo.<account-subdomain>.workers.dev
# Optional. Set these to probe preview or alternate hostnames in test J.
WORKER_PREVIEW_URL=
EXTRA_WORKER_URLS=

# Cloudflare Tunnel and Workers VPC
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=
VPC_SERVICE_ID=

# AWS. deploy.sh reads Terraform outputs when the instance values are empty.
AWS_REGION=us-east-1
INSTANCE_ID=
INSTANCE_PRIVATE_IP=
